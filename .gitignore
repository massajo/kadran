.env
.env.*
!.env.example

# --- Outils locaux ---
.idea/
*.iml
.vscode/
.DS_Store

# --- Données locales (compose : Postgres, MinIO) ---
docker/.data/

# --- Échantillons de fichiers plateformes ---
# Relevés Uber et exports Driversnote contiennent de la PII (spec §8.1).
# Les échantillons ne sont jamais commités : ils circulent hors dépôt.
samples/
*.pdf
!docs/**/*.pdf
